# ╔══════════════════════════════════════════════════════════╗
# ║  WealthPilot 环境配置                                    ║
# ║  复制为 .env 后修改，最低只需填 API Key                   ║
# ╚══════════════════════════════════════════════════════════╝

# ── AI 提供商 ──────────────────────────────────────────────
# 选择 AI 提供商：anthropic、deepseek，或 openai（任何兼容 OpenAI 接口的服务）
AI_PROVIDER=anthropic

# ── Claude API (AI_PROVIDER=anthropic) ──────────────────────
# 必填（当 AI_PROVIDER=anthropic 时）：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── DeepSeek API (AI_PROVIDER=deepseek) ─────────────────────
# 必填（当 AI_PROVIDER=deepseek 时）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 其他兼容 OpenAI 接口的服务 (AI_PROVIDER=openai) ─────────
# 硅基流动、智谱、Moonshot、通义、火山方舟、OpenRouter、本机 Ollama……都走这一种。
# 模型必须支持工具调用（function calling）。本机模型不需要 Key。
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# 服务支持 response_format=json_object 时设为 true；单次输出上限拿不准就用 4096
OPENAI_JSON_MODE=false
OPENAI_MAX_TOKENS=4096

# 说话方式不在这里配：写在数据目录下的 SOUL.md 里（wealthpilot persona / 网页设置）。

# 手机上发图片：要一个能看图的模型。填一个模型名，用的是上面「兼容服务」那一套地址和 Key（如智谱 glm-4v-flash、通义 qwen-vl-plus、本机 llava）；
# 留空时，填了 Claude 的 Key 就用 Claude 看图；都没有就看不了图，机器人会直接说明。
VISION_MODEL=
# 手机上发语音：要一个语音转文字的服务（兼容 OpenAI 的 /audio/transcriptions），如硅基流动的 FunAudioLLM/SenseVoiceSmall。钉钉的语音它自己会识别，不用配。
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# 钉钉：企业内部应用的 Client ID / Client Secret（机器人，Stream 模式）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 每日简报推送时带上当天的大盘复盘（涨停、连板、题材热点、龙虎榜）。不调用模型。
RECAP_PUSH=true
# 不经过配对、直接往这个 Telegram 聊天推送：给没有数据库的定时环境用（GitHub Actions 的日报）。平时不用填。
TELEGRAM_CHAT_ID=

# 联网搜索：固定数据源查不到的事，Agent 自己去搜。auto 不用 Key（读搜索引擎结果页，不稳定）；
# 想稳定就填一家带 Key 的：bocha（博查）/ tavily / brave；或 searxng（自己搭的，填 WEB_SEARCH_URL）；off 关掉。
WEB_SEARCH=auto
WEB_SEARCH_API_KEY=
WEB_SEARCH_URL=

# 备用模型：主模型余额不足、Key 失效、被限流、连不上时，这一轮研究自动换过去（回答上会注明）。
# 填 deepseek / anthropic / openai 之一，要和 AI_PROVIDER 不同，而且那一家自己的 Key 和模型名得配好。留空不启用。
AI_FALLBACK=
# 限流、超时、服务端出错时自动重试几次（按服务商给的等待时间退避）
AI_MAX_RETRIES=3

# ── 在飞书 / 企业微信里对话（推荐在网页「设置 → 手机渠道」里填） ──
# 飞书：企业自建应用，事件订阅选“使用长连接接收事件”，不需要公网地址；改了要重启
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 企业微信：自建应用，回调地址填 https://你的公网地址/api/channel/wecom/callback（必须公网可达）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# ── 用量与预算 ──────────────────────────────────────────────
# 每天最多用多少 token（输入加输出），到了就不再调用模型；0 = 不限
DAILY_TOKEN_BUDGET=0
# 单价（元 / 百万 token）：填了才会把用量折成钱
TOKEN_PRICE_INPUT=0
TOKEN_PRICE_OUTPUT=0
# 几小时内对同一只股票再做深度研究时沿用上次取到的数据；0 = 每次都重新取
RESEARCH_REUSE_HOURS=4

# ── Agent 配置 ──────────────────────────────────────────────
# Agent 最大工具调用轮次（防止无限循环）
AGENT_MAX_TOOL_ROUNDS=3
# Agent 最大输出 token 数（思考 token 也计入；DeepSeek 会自动截到其上限 8192）
AGENT_MAX_TOKENS=16000
# 整轮研究 / 单次模型请求的超时（秒）
RUN_TIMEOUT_SECONDS=180
AI_TIMEOUT_SECONDS=60
# CLI 与 MCP 读取哪个用户的持仓和画像（0=未登录的匿名档）
LOCAL_USER_ID=0

# ── Alpha Vantage（备用行情源，可选）─────────────────────────
ALPHA_VANTAGE_KEY=

# ── 存储 ────────────────────────────────────────────────────
# SQLite 数据库路径（相对于 backend/ 目录）
DB_PATH=./data/wealthpilot.db

# ── 服务 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── JWT 认证 ────────────────────────────────────────────────
# 生产环境务必修改！可用 python3 -c "import secrets; print(secrets.token_urlsafe(32))" 生成
JWT_SECRET=change-this-to-a-random-string-in-production

# ── 前端地址（CORS 白名单）──────────────────────────────────
FRONTEND_URL=http://localhost:5180

# Critic 双闸门校验（证据充分性 + 输出可信度）
CRITIC_ENABLED=true
CRITIC_MAX_REPLANS=1
CRITIC_MAX_REWRITES=2
# 重写用尽后，数字溯源率不低于此值的草稿带标注发布；设为 1 则一律拒答
CRITIC_MIN_GROUNDING_RATE=0.9

# 事后验证：研究发布后提出可核对的验证点（多一次小额模型调用）
CHECKPOINTS_ENABLED=true
# 个人模式：允许给出明确的买卖立场与操作建议，并用涨跌类验证点事后打分。
# 建议单只有在你逐条授权后才会记入持仓台账；不会向券商下单。默认关闭。
ADVICE_MODE=false

# ── 外部 MCP 连接器（可选）──────────────────────────────────
# 连接器本身在 connectors.json 里配置（模板见 connectors.example.json）；
# 这里只放它们要用的令牌，变量名与 connectors.json 里的 auth_env 对应。
# BROKER_MCP_TOKEN=
# DATA_MCP_TOKEN=

# 下单通道。none：授权建议单只把成交记入持仓台账；paper：内置模拟盘，按最新价成交（不动真钱），持仓自动同步进组合
BROKER=none
PAPER_INITIAL_CASH=1000000

# 每日盯盘：后端运行时，交易日到点自动核对验证点、检查持仓与自选的异动并生成简报；配置了 ALERT_WEBHOOK_URL 时有事才推送
WATCH_ENABLED=true
WATCH_TIME=15:30
WATCH_MOVE_PCT=5

# 提取证券名、审核证据、提出验证点等轻活用的模型；留空则与主模型相同
LIGHT_MODEL=
# 技能目录：用户自己写的研究方法（Markdown，格式与 DeepSeek Harness 的 skill 相同）
SKILLS_DIR=./skills
