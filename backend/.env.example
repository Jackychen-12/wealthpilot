# ╔══════════════════════════════════════════════════════════╗
# ║  WealthPilot 环境配置                                    ║
# ║  复制为 .env 后修改，最低只需填 ANTHROPIC_API_KEY         ║
# ╚══════════════════════════════════════════════════════════╝

# ── Claude API ──────────────────────────────────────────────
# 必填：Anthropic API Key（https://console.anthropic.com/）
ANTHROPIC_API_KEY=sk-ant-xxx
# 模型名称（默认 claude-sonnet-4-6）
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Agent 配置 ──────────────────────────────────────────────
# Agent 最大工具调用轮次（防止无限循环）
AGENT_MAX_TOOL_ROUNDS=3
# Agent 最大输出 token 数
AGENT_MAX_TOKENS=4000

# ── Alpha Vantage（备用行情源，可选）─────────────────────────
ALPHA_VANTAGE_KEY=

# ── 存储 ────────────────────────────────────────────────────
# SQLite 数据库路径（相对于 backend/ 目录）
DB_PATH=./data/wealthpilot.db

# ── 服务 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── JWT 认证 ────────────────────────────────────────────────
# 生产环境务必修改！可用 python3 -c "import secrets; print(secrets.token_urlsafe(32))" 生成
JWT_SECRET=change-this-to-a-random-string-in-production

# ── 前端地址（CORS 白名单）──────────────────────────────────
FRONTEND_URL=http://localhost:5173
